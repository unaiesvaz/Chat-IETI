<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.project.ChatController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <padding>
                <Insets top="12.0" right="16.0" bottom="12.0" left="16.0" />
            </padding>
            <Label text="Chat IETI" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="statusLabel" text="Listo" />
        </HBox>
    </top>

    <center>
        <ScrollPane fx:id="conversationScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="messagesBox" fillWidth="true" spacing="10.0">
                    <padding>
                        <Insets top="12.0" right="16.0" bottom="12.0" left="16.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <VBox spacing="8.0">
            <padding>
                <Insets top="10.0" right="16.0" bottom="14.0" left="16.0" />
            </padding>
            <HBox fx:id="attachmentPreview" alignment="CENTER_LEFT" spacing="8.0" visible="false" managed="false" />
            <TextArea fx:id="messageInput" prefRowCount="3" promptText="Escribe un mensaje..." wrapText="true" />
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Button fx:id="attachButton" text="Adjuntar imagen" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="stopButton" text="Detener" disable="true" />
                <Button fx:id="sendButton" text="Enviar" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>